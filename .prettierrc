{
    "plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-svelte"],
    "tailwindStylesheet": "./src/app.css",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "es5",
    "printWidth": 90,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf"
}
