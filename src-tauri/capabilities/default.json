{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "opener:default",
        "secure-keystore:default",
        "google-auth:default",
        {
            "identifier": "http:default",
            "allow": [
                {
                    "url": "http://api.mywayline.com/**"
                }
            ]
        }
    ]
}
